{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://qwen.local/schemas/cabin-upsell.schema.json",
  "title": "CabinUpsell",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "flightCardId", "aircraftKey", "accordion", "cta", "searchId"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "flightCardId": { "type": "string", "description": "关联的 FlightCard.id" },
    "aircraftKey": {
      "type": "string",
      "description": "CabinKB 查询键，例如 CX|A350-1000"
    },
    "facts": {
      "type": "object",
      "additionalProperties": true,
      "description": "座椅/机型事实，缺失字段由 CabinKB 标注"
    },
    "images": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["url", "alt"],
        "properties": {
          "url": { "type": "string", "format": "uri" },
          "alt": { "type": "string" },
          "width": { "type": "integer", "minimum": 1 },
          "height": { "type": "integer", "minimum": 1 },
          "contentHash": { "type": "string" }
        }
      }
    },
    "accordion": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sectionId", "title", "defaultExpanded"],
        "properties": {
          "sectionId": { "type": "string" },
          "title": { "type": "string" },
          "defaultExpanded": { "type": "boolean" },
          "bullets": {
            "type": "array",
            "items": { "type": "string" }
          },
          "imageUrl": {
            "type": "string",
            "format": "uri",
            "description": "该折叠区块主图（可选）"
          }
        }
      }
    },
    "missingDataNotice": {
      "type": "string",
      "description": "无可靠数据时的统一提示文案"
    },
    "cta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "href", "offerId"],
      "properties": {
        "label": { "type": "string" },
        "href": { "type": "string", "description": "列表页或 deep link" },
        "offerId": { "type": "string" },
        "searchId": { "type": "string" }
      }
    },
    "searchId": { "type": "string" }
  }
}
